# ── Buyer agent wallet (Base Sepolia, needs testnet USDC from https://faucet.circle.com) ──
# 0x-prefixed private key of a throwaway testnet wallet. NEVER a mainnet key.
EVM_PRIVATE_KEY=0x...

# ── Seller ──
# Address that receives payments on /api/data and /api/premium (your own testnet address)
SELLER_ADDRESS=0x...
SELLER_PORT=4021
# payTo for the BLOCK demo endpoint /api/risky — a real mainnet-flagged EOA
# (Intercepta quick-scan covers EOAs only; contract addresses 404).
# Default (Lazarus Group / Ronin Bridge exploiter, OFAC-sanctioned) if unset.
# RISKY_PAYTO_ADDRESS=0x098B716B8Aaf21512996dC57EB0615e2383E2f96

# ── Intercepta (Web3 Antivirus) — request key via docs.web3antivirus.io ──
INTERCEPTA_API_KEY=

# ── Policy ──
# Payments above this USD amount escalate to human approval
ESCALATE_THRESHOLD_USD=0.10

# ── World ID for Agents (sandbox.auth.world.org/portal) ──
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=

# ── Dashboard ──
DASHBOARD_PORT=3000
